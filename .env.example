# ============================================================
#  Robo-Shopper V4 — Environment Configuration
# ============================================================

# ---------- LLM Provider ----------
# Options: ollama | groq | openai | openrouter | dashscope | deepseek | mistral | together | fireworks | perplexity | cerebras | sambanova | novita | anyscale
LLM_PROVIDER=ollama

# Model name for your chosen provider (optional — uses provider default if omitted)
LLM_MODEL=llama3.1:8b

# ---------- API Keys (only needed for cloud providers) ----------
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-...
DASHSCOPE_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...
MISTRAL_API_KEY=...
TOGETHER_API_KEY=...
FIREWORKS_API_KEY=...
PERPLEXITY_API_KEY=...
CEREBRAS_API_KEY=...
SAMBANOVA_API_KEY=...
NOVITA_API_KEY=...
ANYSCALE_API_KEY=...

# ---------- Ollama (local) ----------
# If running inside Docker, set this to your host's IP or "host.docker.internal"
OLLAMA_HOST=http://host.docker.internal:11434

# ---------- Telegram Alerts (optional) ----------
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...

# ---------- Agent Treasury ----------
AGENT_WALLET_ADDRESS=0x...
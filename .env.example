# Preferred public exchange (binance | okx). Auto-fallback if blocked.
ROBO_MARKET_EXCHANGE=binance

# Disable the in-server Voice when monitor_service.py runs standalone.
ROBO_VOICE=off

# Qwen orchestrator (qwen_agent.py). Get a key at dashscope.console.aliyun.com
DASHSCOPE_API_KEY=sk-your-key-here

